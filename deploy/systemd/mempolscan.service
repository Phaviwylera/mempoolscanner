[Unit]
Description=Read-only Rust Alloy + Revm mempool scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mempolscan
Group=mempolscan
WorkingDirectory=/opt/mempoolscanner
EnvironmentFile=-/opt/mempoolscanner/.env
ExecStart=/opt/mempoolscanner/bin/mempool-scanner
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/mempoolscanner/logs

[Install]
WantedBy=multi-user.target
