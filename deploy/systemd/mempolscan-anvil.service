[Unit]
Description=Anvil local fork for mempool scanner simulations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mempolscan
Group=mempolscan
WorkingDirectory=/opt/mempoolscanner
EnvironmentFile=/opt/mempoolscanner/.env
ExecStart=/home/mempolscan/.foundry/bin/anvil --fork-url ${HTTP_RPC} --fork-block-number latest --host 127.0.0.1 --port 8545
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mempolscan/.foundry /opt/mempoolscanner/logs

[Install]
WantedBy=multi-user.target

