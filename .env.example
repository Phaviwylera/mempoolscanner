# Public Ethereum endpoints suitable for learning; dedicated Alchemy/Infura/local Geth
# endpoints provide higher rate limits and full mempool coverage.
WS_RPC=wss://ethereum-rpc.publicnode.com
HTTP_RPC=https://ethereum-rpc.publicnode.com

# State endpoint for the mempool SCANNER's revm simulations + fork-head poll ONLY.
# Split from HTTP_RPC so the scanner's high-volume, speculative state reads don't
# saturate (and rate-limit / 429) the keeper + execute path, which must stay
# reliable. Keep HTTP_RPC on your best endpoint (e.g. Alchemy) for the keeper, and
# point SCANNER_STATE_RPC at a SEPARATE endpoint (a second Alchemy app, or another
# provider). If unset, the scanner defaults to publicnode so HTTP_RPC stays free.
# SCANNER_STATE_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_SECOND_KEY

# Optional local IPC socket (e.g. /var/lib/geth/geth.ipc) or fallback Anvil RPC:
# IPC_RPC=/var/lib/geth/geth.ipc
# ANVIL_RPC=http://127.0.0.1:8545

# Fork-trust & simulation settings (defaults shown):
# FORK_MAX_LAG=3
# FORK_CHECK_DEPTH=1
# FORK_POLL_SECONDS=3
# WORKER_CONCURRENCY=16
# SIM_TIMEOUT_MS=6000
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Aave V3 keeper
# ---------------------------------------------------------------------------
# Borrowers whose health factor the keeper polls. Comma-separated, full 42-char
# addresses. Empty means the keeper polls nothing, so /api/opportunities stays
# empty. When a tracked borrower's HF drops below 1.0 the keeper resolves their
# largest collateral and debt reserve (via the Aave data provider at
# 0x0a16f2FCC0D44FaE41cc54e079281D84A363bECD) so the opportunity carries the
# asset addresses, not just the borrower.
#
# NOTE: snapshot addresses go stale fast. Discover currently-active borrowers
# with recent Borrow events, e.g. (requires foundry `cast`):
#   cast logs --rpc-url "$HTTP_RPC" --from-block $(( $(cast block-number --rpc-url "$HTTP_RPC") - 800 )) \
#     --address 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2 \
#     "Borrow(address,address,address,uint256,uint8,uint256,uint16)"
# then check each candidate's health factor:
#   cast call 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2 \
#     "getUserAccountData(address)(uint256,uint256,uint256,uint256,uint256,uint256)" <borrower>
TRACKED_BORROWERS=0xe947e01a0c8a15d84b1285258cd0b1788f81d90f

# Seconds between keeper health-factor polls. 0 disables the timer.
KEEPER_POLL_SECONDS=60

# ---------------------------------------------------------------------------
# Execution (spends real money in live mode -- read before setting)
# ---------------------------------------------------------------------------
# off     : observe only, nothing is signed. The default.
# dry_run : simulate + sign + write exec_audit.jsonl, but never broadcast.
# live    : simulate + sign + broadcast via Flashbots.
EXECUTION_MODE=off

# Required for dry_run and live. The process refuses to start without a signer.
# EXEC_PRIVATE_KEY=0x...
# or
# EXEC_KEYSTORE_PATH=/path/to/keystore.json

# Required when execution is enabled: RPC used for the pre-sign re-simulation.
# EXEC_RPC_URL=https://...

# Required in live mode: the deployed AaveV3Liquidator contract. Live mode
# aborts at startup if this is unset.
# EXEC_LIQUIDATOR_ADDRESS=0x...

# Minimum net profit in wei before the gate will sign. Default 0.
# EXEC_MIN_PROFIT_WEI=0

# ---------------------------------------------------------------------------
# Manual offline transaction builder (--build-tx <address> and /api/build-tx)
# ---------------------------------------------------------------------------
# Builds and signs ONE liquidation tx targeting the AaveV3Liquidator contract,
# then writes signed_tx.txt and exits. Never broadcasts. Needs a signer
# (EXEC_PRIVATE_KEY) and EXEC_LIQUIDATOR_ADDRESS; works regardless of
# EXECUTION_MODE. Optional tuning:
# BUILD_TX_SWAP_FEE=3000      # Uniswap V3 fee tier for collateral->debt (500/3000/10000)
# BUILD_TX_MIN_PROFIT=0       # minProfit in debt-asset units (contract reverts below it)
# BUILD_TX_GAS_LIMIT=380000   # gas limit for the flash-loan liquidation
# EXEC_CHAIN_ID=1

# Broadcast path.
# FLASHBOTS_RELAY=https://relay.flashbots.net
# BUILDER_RELAYS=https://builder1,https://builder2

# Gas-aware dynamic bidding (the "90% rule"). Applied to every signed
# liquidation (normal + SVR). The builder bribe = (gross - gas_cost) * BID_FRACTION
# is paid as EIP-1559 priority fee (no contract change).
# BID_FRACTION=0.90                 # builder's share of the surplus (default 0.90)
# EXEC_GAS_SAFETY_BUFFER_WEI=0      # added to gas cost in the coverage gate

# ---------------------------------------------------------------------------
# Phase 6 — Chainlink SVR back-running (Flashbots MEV-Share)
# ---------------------------------------------------------------------------
# Opt-in. With SVR_FEEDS set, the keeper subscribes to the MEV-Share hint
# stream, decodes forward()->transmitSecondary() SVR oracle updates, and on a
# resulting liquidatable borrower submits a same-block back-run bundle
# [ {hash: SVR update}, {tx: our liquidation} ] via mev_sendBundle.
#
# SUBMISSION IS GATED ON EXECUTION_MODE=live. In dry_run the bundle is built and
# logged (audit outcome svr_dry_run_signed) but never sent. An unset/empty
# SVR_FEEDS disables the subscriber entirely (the keeper runs normally).
#
# Comma-separated SVR aggregator proxy addresses (the `to` of forward()).
# Mainnet AAVE/USD SVR proxy (verified from Chainlink's SVR feed registry):
# SVR_FEEDS=0xF02C1e2A3B77c1cacC72f72B44f7d0a4c62e4a85
# MEV_SHARE_SSE_URL=https://mev-share.flashbots.net   # default; override if needed
# SVR_DEBUG_HINTS=1                 # log a bounded sample of raw hints for schema validation

# ---------------------------------------------------------------------------
# RPC throttling
# ---------------------------------------------------------------------------
# SIM_CONCURRENCY=2
# FETCH_CONCURRENCY=8
# SIM_TIMEOUT_MS=10000
