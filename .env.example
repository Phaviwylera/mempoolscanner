# Public Ethereum endpoints suitable for learning; dedicated Alchemy/Infura/local Geth
# endpoints provide higher rate limits and full mempool coverage.
WS_RPC=wss://ethereum-rpc.publicnode.com
HTTP_RPC=https://ethereum-rpc.publicnode.com

# Optional local IPC socket (e.g. /var/lib/geth/geth.ipc) or fallback Anvil RPC:
# IPC_RPC=/var/lib/geth/geth.ipc
# ANVIL_RPC=http://127.0.0.1:8545

# Fork-trust & simulation settings (defaults shown):
# FORK_MAX_LAG=3
# FORK_CHECK_DEPTH=1
# FORK_POLL_SECONDS=3
# WORKER_CONCURRENCY=16
# SIM_TIMEOUT_MS=6000
# LOG_LEVEL=INFO
