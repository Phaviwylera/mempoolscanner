# These public Ethereum endpoints are suitable for learning and may be rate-limited.
# Choose a provider that supports eth_subscribe("newPendingTransactions") for full coverage.
WS_RPC=wss://ethereum-rpc.publicnode.com
HTTP_RPC=https://ethereum-rpc.publicnode.com
ANVIL_RPC=http://127.0.0.1:8545

# Fork-trust settings. The defaults below apply when a variable is unset or invalid.
# FORK_MAX_LAG=3
# FORK_CHECK_DEPTH=1
# FORK_POLL_SECONDS=3
# LOG_LEVEL=INFO
